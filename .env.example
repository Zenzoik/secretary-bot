BOT_TOKEN=replace-with-bot-token
WEBHOOK_SECRET=replace_with_random_secret
MASTER_TELEGRAM_USER_ID=123456789
BOT_USERNAME=your_bot_username
PUBLIC_BASE_URL=https://example.com
LOG_LEVEL=INFO
UPDATE_QUEUE_SIZE=1000

# --- Docker Compose ---
# Пароль пользователя Postgres внутри стека. Compose подставляет его и в
# DATABASE_URL приложения, отдельно его прописывать не нужно.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Запуск без Docker ---
# Compose эти два значения перекрывает своими (postgres:5432, redis:6379).
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql+asyncpg://secretary:secretary@127.0.0.1:5432/secretary
DEDUP_TTL_SECONDS=86400

# Пусто = политика FR-2: все чаты, кроме исключений.
# Заполнить на время отладки, чтобы бот видел только ваши чаты.
ALLOWED_CHAT_IDS=
# Без ключа классификатор работает на словаре ключевых слов.
ANTHROPIC_API_KEY=
CLASSIFIER_TIMEOUT_SECONDS=8
