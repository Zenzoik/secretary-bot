BOT_TOKEN=replace-with-bot-token
WEBHOOK_SECRET=replace_with_random_secret
PUBLIC_BASE_URL=https://example.com
LOG_LEVEL=INFO
UPDATE_QUEUE_SIZE=1000
REDIS_URL=redis://127.0.0.1:6379/0
DEDUP_TTL_SECONDS=86400
DATABASE_URL=postgresql+asyncpg://secretary:secretary@127.0.0.1:5432/secretary
# Empty means the FR-2 policy: every chat except exclusions.
# Fill it while testing to restrict the bot to your own chats.
ALLOWED_CHAT_IDS=
# Without a key the classifier falls back to the keyword dictionary.
ANTHROPIC_API_KEY=
CLASSIFIER_TIMEOUT_SECONDS=8
